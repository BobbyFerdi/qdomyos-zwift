    onNameChanged: canvas.requestPaint()
    onColorChanged: canvas.requestPaint()

    Canvas {
        id: canvas
        anchors.centerIn: parent
        // Drawn at the pixel density of the screen and scaled down, so it stays sharp
        width: icon.size * Screen.devicePixelRatio
        height: icon.size * Screen.devicePixelRatio
        scale: 1 / Screen.devicePixelRatio
        onPaint: {
            var ctx = getContext("2d")
            ctx.reset()
            // The symbols use viewBox 0 -960 960 960
            ctx.scale(width / 960, height / 960)
            ctx.translate(0, 960)
            ctx.path = icon.pathOf(icon.name)
            ctx.fillStyle = icon.color
            ctx.fill()
        }
    }
